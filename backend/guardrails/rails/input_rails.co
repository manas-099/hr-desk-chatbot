# Input Safety Subflows

define subflow self check input
  $allowed = execute self_check_input
  if not $allowed
    bot inform cannot assist
    stop

define subflow detect harassment intent
  $is_harassment = execute detect_harassment_intent
  if $is_harassment
    execute create_anonymous_ticket(type="harassment_report")
    bot inform harassment report received
    stop

define bot inform cannot assist
  "I am unable to assist with that request. Please contact HR directly at hr@company.com or call the Employee Hotline."

define bot inform harassment report received
  "Thank you for bringing this to our attention. Your report has been logged anonymously and will be reviewed by HR. If this is an emergency, please contact local authorities or our Employee Assistance Program at 1-800-EAP-HELP."
